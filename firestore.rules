rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function allowedPublicNotification() { return request.resource.data.type in ['review','message','subscriber','donation']; }

    match /admins/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /menuItems/{id} { allow read: if true; allow write: if isAdmin(); }
    match /promotions/{id} { allow read: if true; allow write: if isAdmin(); }
    match /heroSlides/{id} { allow read: if true; allow write: if isAdmin(); }
    match /feedGallery/{id} { allow read: if true; allow write: if isAdmin(); }
    match /teamMembers/{id} { allow read: if true; allow write: if isAdmin(); }
    match /siteContent/{id} { allow read: if true; allow write: if isAdmin(); }
    match /reviews/{id} { allow read: if isAdmin() || resource.data.approved == true; allow create: if request.resource.data.approved == false; allow update, delete: if isAdmin(); }
    match /orders/{id} { allow create: if request.resource.data.payment == 'Pending' || request.resource.data.paymentStatus == 'Pending'; allow read, update, delete: if isAdmin(); }
    match /abandonedCarts/{id} { allow create, update: if true; allow read, delete: if isAdmin(); }
    match /donations/{id} { allow create: if true; allow read, update, delete: if isAdmin(); }
    match /contacts/{id} { allow create: if true; allow read, update, delete: if isAdmin(); }
    match /subscribers/{id} { allow create: if true; allow read, update, delete: if isAdmin(); }
    match /notifications/{id} { allow create: if allowedPublicNotification(); allow read, update, delete: if isAdmin(); }
    match /activity/{id} { allow read, write: if isAdmin(); }
    match /customers/{id} { allow read, write: if isAdmin(); }
    match /paymentReferences/{id} { allow read, write: if isAdmin(); }
    match /inventory/{id} { allow read, write: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
